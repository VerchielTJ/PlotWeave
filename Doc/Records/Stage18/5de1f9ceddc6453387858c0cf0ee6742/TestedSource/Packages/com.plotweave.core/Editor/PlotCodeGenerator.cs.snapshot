using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using UnityEditor;

namespace PlotWeave.Editor
{
    /// <summary>事件定义 → 接口与参数适配器。生成物只依赖 PlotWeave.Runtime。</summary>
    public static class PlotCodeGenerator
    {
        public static void Generate(PlotAsset asset)
        {
            var path = EditorUtility.SaveFilePanelInProject("生成事件接口与适配器", "PlotCommandAdapters.g", "cs", "建议放入单独的 Generated 目录。");
            if (string.IsNullOrEmpty(path)) return;
            Write(asset.document, path); AssetDatabase.Refresh();
        }
        public static void Write(PlotDocument data, string path)
        {
            PlotValidation.Check(data).ThrowIfInvalid();
            var code = Build(data);
            var directory = Path.GetDirectoryName(path);
            if (!string.IsNullOrEmpty(directory)) Directory.CreateDirectory(directory);
            File.WriteAllText(path, code, new UTF8Encoding(false));
        }
        public static string Build(PlotDocument data)
        {
            var output = new StringBuilder("// <auto-generated />\nusing PlotWeave;\n\nnamespace PlotWeave.Generated\n{\n");
            var types = new HashSet<string>(StringComparer.Ordinal);
            foreach (var definition in data.commands)
            {
                var name = Identifier(definition.key) + "Command";
                if (!types.Add(name)) throw new FormatException("命令生成类型名冲突：" + definition.key);
                var properties = new HashSet<string>(StringComparer.Ordinal);
                output.Append("    public interface I").Append(name).Append("\n    {\n");
                foreach (var p in definition.parameters)
                {
                    var property = Identifier(p.key);
                    if (!properties.Add(property)) throw new FormatException("参数生成属性名冲突：" + p.key);
                    output.Append("        ").Append(TypeName(p.type)).Append(' ').Append(property).Append(" { get; }\n");
                }
                output.Append("    }\n    public sealed class ").Append(name).Append("Adapter : I").Append(name).Append("\n    {\n        private readonly PlotCommand _command;\n        public ")
                    .Append(name).Append("Adapter(PlotCommand command)\n        {\n            _command = command ?? throw new System.ArgumentNullException(nameof(command));\n            if (command.key != ")
                    .Append(Literal(definition.key)).Append(") throw new System.ArgumentException(\"Command key mismatch.\");\n        }\n");
                foreach (var p in definition.parameters)
                {
                    var get = "_command.Get(" + Literal(p.key) + ", " + Literal(p.defaultValue) + ")";
                    var method = Reader(p.type);
                    output.Append("        public ").Append(TypeName(p.type)).Append(' ').Append(Identifier(p.key)).Append(" => ")
                        .Append(method == "" ? get : "PlotArgumentReader." + method + "(" + get + ")").Append(";\n");
                }
                output.Append("    }\n");
            }
            output.Append("}\n"); return output.ToString();
        }
        private static string Literal(string value)
        {
            var result = new StringBuilder("\"");
            foreach (var c in value ?? "")
            {
                switch (c)
                {
                    case '\\': result.Append("\\\\"); break;
                    case '"': result.Append("\\\""); break;
                    case '\n': result.Append("\\n"); break;
                    case '\r': result.Append("\\r"); break;
                    case '\t': result.Append("\\t"); break;
                    default: if (c < 32 || c == '\u2028' || c == '\u2029') result.Append("\\u").Append(((int)c).ToString("x4")); else result.Append(c); break;
                }
            }
            return result.Append('"').ToString();
        }
        private static string Identifier(string key)
        {
            var result = new StringBuilder("Pw_");
            foreach (var c in key ?? "") result.Append(char.IsLetterOrDigit(c) || c == '_' ? c : '_');
            return result.ToString();
        }
        private static string TypeName(PlotValueType type)
        {
            switch (type)
            {
                case PlotValueType.Int: return "int";
                case PlotValueType.Float: return "float";
                case PlotValueType.Bool: return "bool";
                case PlotValueType.Vector2: return "UnityEngine.Vector2";
                case PlotValueType.Vector3: return "UnityEngine.Vector3";
                case PlotValueType.Color: return "UnityEngine.Color";
                default: return "string";
            }
        }
        private static string Reader(PlotValueType type)
        {
            switch (type)
            {
                case PlotValueType.Int: return "Int";
                case PlotValueType.Float: return "Float";
                case PlotValueType.Bool: return "Bool";
                case PlotValueType.Vector2: return "Vector2";
                case PlotValueType.Vector3: return "Vector3";
                case PlotValueType.Color: return "Color";
                default: return "";
            }
        }
    }
}
