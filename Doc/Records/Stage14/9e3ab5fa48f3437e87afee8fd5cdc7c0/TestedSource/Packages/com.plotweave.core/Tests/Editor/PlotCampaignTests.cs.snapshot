using System;
using System.Collections.Generic;
using System.IO;
using System.Threading;
using NUnit.Framework;
using PlotWeave.Chapters;
using PlotWeave.Playback;
using UnityEngine;

namespace PlotWeave.Tests
{
    public sealed class PlotCampaignTests
    {
        private static PlotCampaignCatalog Catalog()
        {return new PlotCampaignCatalog{chapters=new List<PlotCampaignChapter>{new PlotCampaignChapter{kind=PlotChapterKind.Main,id=10,episodes=new List<int>{100,500}},new PlotCampaignChapter{kind=PlotChapterKind.Main,id=80,episodes=new List<int>{900},unlockDate="2026-10-28",unlockArea="area2"}},episodes=new List<PlotCampaignEpisode>{new PlotCampaignEpisode{kind=PlotChapterKind.Main,id=100,entryNode=1,awardID=1},new PlotCampaignEpisode{kind=PlotChapterKind.Main,id=500,entryNode=1,awardID=1},new PlotCampaignEpisode{kind=PlotChapterKind.Main,id=900,entryNode=1}},rewards=new List<PlotCampaignReward>{new PlotCampaignReward{id=1,items=new List<PlotCampaignItem>{new PlotCampaignItem{itemID=7,count=10}}}}};}
        private static PlotChapterCompletion Completion(int id,string token)=>new PlotChapterCompletion(new PlotChapterRequest(PlotChapterKind.Main,id.ToString()),token);
        [Test] public void NonConsecutiveIdsFollowConfiguredOrderAndSelectTheFirstUnreadEpisode()
        {var catalog=Catalog();catalog.Validate();var progress=new PlotCampaignProgressStore();var chapter=catalog.chapters[0];Assert.That(catalog.InitialEpisode(chapter,progress),Is.EqualTo(100));Assert.That(catalog.EpisodeState(chapter,100,progress,DateTime.Today,_=>true),Is.EqualTo(PlotCampaignItemState.Current));Assert.That(catalog.EpisodeState(chapter,500,progress,DateTime.Today,_=>true),Is.EqualTo(PlotCampaignItemState.Locked));progress.Commit(Completion(100,"one"),catalog.Reward(1),CancellationToken.None);Assert.That(catalog.InitialEpisode(chapter,progress),Is.EqualTo(500));Assert.That(catalog.Progress(chapter,progress),Is.EqualTo(50));Assert.That(catalog.EpisodeState(chapter,500,progress,DateTime.Today,_=>true),Is.EqualTo(PlotCampaignItemState.Current));}
        [Test] public void DateAreaAndPreviousChapterMustAllBeUnlocked()
        {var catalog=Catalog();var progress=new PlotCampaignProgressStore();var chapter=catalog.chapters[1];Assert.That(catalog.LockReason(chapter,progress,new DateTime(2026,10,27),_=>true),Does.Contain("后解锁"));Assert.That(catalog.LockReason(chapter,progress,new DateTime(2026,10,28),_=>false),Does.Contain("area2"));Assert.That(catalog.LockReason(chapter,progress,new DateTime(2026,10,28),_=>true),Does.Contain("前一章节"));progress.ImportLegacyProgress(catalog,PlotChapterKind.Main,500);Assert.That(catalog.ChapterState(chapter,progress,new DateTime(2026,10,28),_=>true),Is.EqualTo(PlotCampaignItemState.Current));}
        [Test] public void FirstRewardsAndReceiptPersistAtomicallyAndRetryDoesNotGrantAgain()
        {var path=Path.Combine(Path.GetTempPath(),"PlotWeaveCampaign_"+Guid.NewGuid().ToString("N")+".json");try{var catalog=Catalog();var progress=new PlotCampaignProgressStore(path);Assert.That(progress.Commit(Completion(100,"receipt"),catalog.Reward(1),CancellationToken.None).NewlyCompleted,Is.True);progress=new PlotCampaignProgressStore(path);Assert.That(progress.ItemCount(7),Is.EqualTo(10));Assert.That(progress.Commit(Completion(100,"receipt"),catalog.Reward(1),CancellationToken.None).NewlyCompleted,Is.True);Assert.That(progress.Commit(Completion(100,"another"),catalog.Reward(1),CancellationToken.None).NewlyCompleted,Is.False);Assert.That(progress.ItemCount(7),Is.EqualTo(10));Assert.Throws<InvalidOperationException>(()=>progress.Commit(Completion(500,"receipt"),catalog.Reward(1),CancellationToken.None));}finally{if(File.Exists(path))File.Delete(path);}}
        [Test] public void CancelledOrOverflowingRewardTransactionsCannotAdvanceProgress()
        {var progress=new PlotCampaignProgressStore();var token=new CancellationToken(true);Assert.Throws<OperationCanceledException>(()=>progress.Commit(Completion(100,"cancel"),Catalog().Reward(1),token));Assert.That(progress.IsRead(PlotChapterKind.Main,100),Is.False);progress.Commit(Completion(100,"max"),new[]{new PlotCampaignItem{itemID=7,count=int.MaxValue}},CancellationToken.None);Assert.Throws<OverflowException>(()=>progress.Commit(Completion(500,"overflow"),Catalog().Reward(1),CancellationToken.None));Assert.That(progress.IsRead(PlotChapterKind.Main,500),Is.False);Assert.That(progress.ItemCount(7),Is.EqualTo(int.MaxValue));}
        [Test] public void ImportingLegacyProgressDoesNotGrantRewardsAndAllReadSelectionIsValid()
        {var catalog=Catalog();var progress=new PlotCampaignProgressStore();progress.ImportLegacyProgress(catalog,PlotChapterKind.Main,500);Assert.That(catalog.Progress(catalog.chapters[0],progress),Is.EqualTo(100));Assert.That(catalog.InitialEpisode(catalog.chapters[0],progress),Is.EqualTo(500));Assert.That(progress.ItemCount(7),Is.Zero);Assert.That(progress.IsRead(PlotChapterKind.Daily,100),Is.False);}
        [Test] public void BackendRejectsLockedEpisodesAndReplaysWithoutAnotherReport()
        {var catalog=Catalog();var document=new PlotPlaybackDocument{Nodes=new List<PlotPlaybackNode>{new PlotPlaybackNode{ScenesID=1}}};var progress=new PlotCampaignProgressStore();var backend=new PlotCampaignLocalBackend(catalog,document,progress,()=>new DateTime(2026,10,28),_=>true);Assert.Throws<InvalidOperationException>(()=>backend.LoadAsync(Completion(500,"x").Request,CancellationToken.None));var content=backend.LoadAsync(Completion(100,"x").Request,CancellationToken.None).Result;Assert.That(content.RequiresCompletionReport,Is.True);backend.CompleteAsync(Completion(100,"x"),CancellationToken.None).GetAwaiter().GetResult();Assert.That(backend.LoadAsync(Completion(100,"y").Request,CancellationToken.None).Result.RequiresCompletionReport,Is.False);}
        [Test] public void InvalidCatalogDoesNotHideMissingReferencesOrDates()
        {var catalog=Catalog();catalog.chapters[0].episodes.Add(123);Assert.Throws<System.Collections.Generic.KeyNotFoundException>(()=>catalog.Episode(PlotChapterKind.Main,123));Assert.Throws<FormatException>(()=>catalog.Validate());catalog=Catalog();catalog.chapters[0].unlockDate="yesterday";Assert.Throws<FormatException>(()=>catalog.Validate());catalog=Catalog();catalog.episodes[0].awardID=999;Assert.Throws<FormatException>(()=>catalog.Validate());}
        [Test] public void CorruptSavedReceiptsAreRejected()
        {var path=Path.Combine(Path.GetTempPath(),"PlotWeaveCampaignBad_"+Guid.NewGuid().ToString("N")+".json");try{File.WriteAllText(path,"{\"version\":1,\"read\":[],\"inventory\":[],\"receipts\":[{\"id\":\"same\",\"key\":\"Main:1\"},{\"id\":\"same\",\"key\":\"Main:2\"}]}");Assert.Throws<FormatException>(()=>new PlotCampaignProgressStore(path));}finally{File.Delete(path);}}
        [Test] public void CfgPropertiesAndNeutralDictionariesUseTheSameReader()
        {var chapter=PlotCampaignCatalog.ReadChapter(new Dictionary<string,object>{{"ID",10},{"Name","title"},{"PlotIDs",new[]{100,500}},{"UnlockDate","2026-10-28"}},PlotChapterKind.Main);Assert.That(chapter.PlotIDs,Is.EqualTo(new[]{100,500}));var episode=PlotCampaignCatalog.ReadEpisode(new EpisodeCfg(),PlotChapterKind.Daily);Assert.That(episode.ID,Is.EqualTo(123));Assert.That(episode.entryNode,Is.EqualTo(4));}
        public sealed class EpisodeCfg {public int ID=>123;public string Name=>"episode";public string Desc=>"description";public int AwardID=>0;public int AtomTargetID=>4;}
    }
}
