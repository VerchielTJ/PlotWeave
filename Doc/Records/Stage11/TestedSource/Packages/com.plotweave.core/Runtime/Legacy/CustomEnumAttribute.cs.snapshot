using UnityEngine;

namespace PlotWeave.Legacy
{
    public sealed class CustomEnumAttribute : PropertyAttribute
    { public string EnumName { get; } public string SourceMember { get; } public CustomEnumAttribute(string enumName, string sourceMember = "parameterEnums") { EnumName = enumName; SourceMember = sourceMember; } }
    public sealed class EnumTypeAttribute : PropertyAttribute
    { public string SourceMember { get; } public EnumTypeAttribute(string sourceMember = "parameterEnums") { SourceMember = sourceMember; } }
}
